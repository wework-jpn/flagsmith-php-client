{
  "name": "wework-japan/flagsmith-laravel-client",
  "type": "library",
  "version": "5.1.1",
  "license": "BSD-3-Clause",
  "authors": [
    {
      "name": "Ben Rometsch",
      "email": "ben.rometsch@flagsmith.com"
    }
  ],
  "require": {
    "php": ">=8.1",
    "ext-bcmath": "*",
    "illuminate/support": "^9.0 || ^10.0 || ^11.0 || ^12.0",
    "php-http/discovery": "^1.14",
    "psr/simple-cache": ">=1.0",
    "psr/http-factory-implementation": "^1.0",
    "psr/http-client-implementation": "^1.0",
    "psr/http-message-implementation": "^1.0",
    "softcreatr/jsonpath": "^0.10.0 || ^0.11.0 || ^1.0"
  },
  "require-dev": {
    "guzzlehttp/guzzle": "^7.3",
    "guzzlehttp/psr7": "^2.1.0",
    "phpunit/phpunit": "^9.5",
    "symfony/cache": "^5.4.6",
    "friendsofphp/php-cs-fixer": "^3.6",
    "doppiogancio/mocked-client": "^3.0",
    "colinodell/json5": "^3.0",
    "vlucas/phpdotenv": "^5.6",
    "phpstan/phpstan": "^2.1"
  },
  "autoload": {
    "psr-4": {
      "Flagsmith\\": "src",
      "FlagsmithTest\\": "tests"
    }
  },
  "scripts": {
    "format": "php-cs-fixer fix -vvv --config=.php-cs-fixer.php --sequential",
    "lint": "php-cs-fixer fix -vvv --config=.php-cs-fixer.php --dry-run --diff --sequential",
    "analyse": "phpstan analyse --configuration=phpstan.neon --memory-limit=1G --no-progress --debug",
    "test": "phpunit",
    "quality": [
      "@lint",
      "@analyse",
      "@test"
    ],
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "extra": {
    "laravel": {
      "providers": [
        "Flagsmith\\Laravel\\FlagsmithServiceProvider"
      ],
      "aliases": {
        "Flagsmith": "Flagsmith\\Laravel\\Facades\\Flagsmith"
      }
    }
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true
    }
  }
}
